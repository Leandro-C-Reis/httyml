{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "httyml",
  "version": "0.1.0",
  "identifier": "com.leandro.httyml",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HTTYML // TERMINAL CORE",
        "maximized": true,
        "decorations": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/httyml-daemon"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NjM5NENGQkRDQjU4QjYKUldTMldNdTl6NVJqdDVTM0w1R1puMVIvNXZCQWxvNXMxdXN4TTNqYjFDQjRSTTZhT3F3NDQxNFEK",
      "endpoints": [
        "https://github.com/Leandro-C-Reis/httyml/releases/latest/download/latest.json"
      ]
    }
  }
}
